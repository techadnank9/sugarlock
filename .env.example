# Database
DATABASE_URL=postgresql://user:pass@host:5432/sugarlock

# Auth0 (@auth0/nextjs-auth0 v4 — see node_modules/@auth0/nextjs-auth0/README.md)
AUTH0_SECRET=            # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
CONFIRM_TOKEN_SECRET=    # signs confirmer single-purpose invite links

# Cron
CRON_SECRET=             # optional; protects /api/cron/order-check in production
